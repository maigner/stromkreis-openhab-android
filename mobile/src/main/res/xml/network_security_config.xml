<?xml version="1.0" encoding="utf-8"?>
<!-- The app only talks to stromkreis.net over https, with the system's certificate validation:
     no cleartext traffic and no user-installed CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
